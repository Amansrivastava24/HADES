# OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_ID=gpt-4o-mini
OPENAI_REASONING_MODEL_ID=gpt-4o

# Embedding Configuration: 'openai' or 'fake'
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Tavily Search API Key for Real-World Learning Resources Discovery
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://hcl:hcl_dev_password@postgres:5432/hcl_learning
